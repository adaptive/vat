{
  "name": "vat",
  "version": "0.1.4",
  "description": "EU VAT Information Exchange System API. Validation of VAT numbers at scale.",
  "type": "module",
  "main": "src/index.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adaptive/vat.git"
  },
  "author": "Hugo Romano <hugoromano@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/adaptive/vat/issues"
  },
  "homepage": "https://github.com/adaptive/vat#readme",
  "dependencies": {
    "fast-xml-parser": "5.11.1",
    "jsvat": "2.5.4"
  },
  "devDependencies": {
    "prettier": "3.9.8",
    "wrangler": "4.135.0"
  },
  "private": true
}
